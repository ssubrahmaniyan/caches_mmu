VERILATOR_FLAGS += -DVERBOSE -DVM_TRACE
VERILATOR_FLAGS += --stats -O3 $(verilate_fast) -LDFLAGS "-static" --x-assign fast --x-initial fast \
--noassert sim_main.cpp --bbox-sys -Wno-STMTDLY -Wno-UNOPTFLAT -Wno-WIDTH \
-Wno-lint -Wno-COMBDLY -Wno-INITIALDLY --autoflush $(coverage) $(trace) --threads $(THREADS) \
-DBSV_RESET_FIFO_HEAD -DBSV_RESET_FIFO_ARRAY
TOP_MODULE=mknb_dcache_tb
TOP_FILE=nb_dcache_tb.bsv

default: link_verilator simulate

.PHONY: compile
compile:
	@echo Compiling...
	#bsc -u -sim -simdir inter -bdir inter -D simulate=True -info-dir inter -keep-fires -p .:%/Prelude:%/Libraries:%/Libraries/BlueNoC:./../../../common_bsv:./../../tb -g $(TOP_MODULE)  ../../tb/$(TOP_FILE) 
	bsc -u -verilog -elab -vdir verilog -bdir inter -D simulate=True -D XLEN=64 -D asidwidth=4 -D dtlbsize=8  +RTS -K1000M -RTS -info-dir inter -suppress-warnings G0020 -keep-fires -p .:%/Prelude:%/Libraries:%/Libraries/BlueNoC:./../../../common_bsv:./../../tb -g $(TOP_MODULE) ../../tb/$(TOP_FILE)
	@echo Compilation finished
	#@notify-send "BSV Compilation Done"

.PHONY: link
link:
	@echo Linking...
	bsc -e $(TOP_MODULE) -sim -o ./out -simdir inter -p .:%/Prelude:%/Libraries:%/Libraries/BlueNoC:./../../../common_bsv:./../../tb -bdir inter -keep-fires 
	@echo Linking finished

.PHONY: link_verilator
link_verilator: ## Generate simulation executable using Verilator
	@echo "Linking $(TOP_MODULE) using verilator"
	@mkdir -p obj_dir
	@echo "#define TOPMODULE V$(TOP_MODULE)" > sim_main.h
	@echo '#include "V$(TOP_MODULE).h"' >> sim_main.h
	verilator --trace $(VERILATOR_FLAGS) --cc $(TOP_MODULE).v -y verilog --exe
	@ln -f -s sim_main.cpp obj_dir/sim_main.cpp
	@ln -f -s sim_main.h obj_dir/sim_main.h
	@make -j4 -C obj_dir -f V$(TOP_MODULE).mk
	@cp obj_dir/V$(TOP_MODULE) out

.PHONY: simulate
simulate:
	@echo Simulation...
	./out +fullverbose +trace >log
	#./out +fullverbose >log
	@echo Simulation finished

.PHONY: clean
clean:
	exec rm -f inter/tlb.bo inter/mshr.bo inter/nb_dcache_types.bo inter/nb_dcache_tb.bo inter/fill_buffer.bo inter/nb_dcache.bo inter/bram_1rw.bo inter/bram_1r1w.bo inter/replacement_dcache.bo inter/mem_config.bo
	exec rm -f inter/mkmshr_instance.ba inter/mkmem_config.ba inter/mknb_dcache_instance.ba inter/$(TOP_MODULE).ba inter/mkfill_buffer_instance.ba
	exec rm -f inter/model_mknb_dcache_tb.o inter/$(TOP_MODULE).o

.PHONY: full_clean
full_clean:
	rm -f inter/tlb.bo inter/mshr.bo inter/nb_dcache_types.bo inter/nb_dcache_tb.bo inter/fill_buffer.bo inter/nb_dcache.bo inter/bram_1rw.bo inter/bram_1r1w.bo inter/replacement_dcache.bo inter/mem_config.bo
	rm -f inter/mkmshr_instance.ba inter/mkmem_config.ba inter/mknb_dcache_instance.ba inter/$(TOP_MODULE).ba inter/mkfill_buffer_instance.ba
	rm -f inter/model_mknb_dcache_tb.o inter/$(TOP_MODULE).o
	rm -f inter/$(TOP_MODULE).h inter/model_mknb_dcache_tb.h
	rm -f inter/$(TOP_MODULE).cxx inter/model_mknb_dcache_tb.cxx
	rm -rf inter/*
	rm -rf obj_dir/*
