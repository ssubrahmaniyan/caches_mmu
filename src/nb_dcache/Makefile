### Makefile for the nb_dcache project
### Generated by Bluespec Workstation on Wed Jul 10 14:33:27 IST 2019

default: full_clean compile link simulate

.PHONY: compile
compile:
	@echo Compiling...
	bsc -u -sim -simdir inter -bdir inter -info-dir inter -keep-fires -p .:%/Prelude:%/Libraries:%/Libraries/BlueNoC:./../../../common_bsv -g mknb_dcache_instance  nb_dcache.bsv 
	#bsc -u -sim -simdir inter -bdir inter -info-dir inter -keep-fires -p .:%/Prelude:%/Libraries:%/Libraries/BlueNoC:./../../../common_bsv -g mkmem_config  mem_config.bsv 
	@echo Compilation finished

.PHONY: link
link:
	@echo Linking...
	bsc -e mknb_dcache_instance -sim -o ./out -simdir inter -p .:%/Prelude:%/Libraries:%/Libraries/BlueNoC:./../../../common_bsv -bdir inter -keep-fires 
	@echo Linking finished

.PHONY: simulate
simulate:
	@echo Simulation...
	./out 
	@echo Simulation finished

.PHONY: clean
clean:
	exec rm -f inter/fill_buffer.bo inter/nb_dcache_types.bo inter/mem_config.bo inter/bram_1r1w.bo inter/bram_1rw.bo inter/tlb.bo inter/mshr.bo
	exec rm -f inter/mkfill_buffer_instance.ba inter/mkmshr_instance.ba

.PHONY: full_clean
full_clean:
	rm -f inter/fill_buffer.bo inter/nb_dcache_types.bo inter/mem_config.bo inter/bram_1r1w.bo inter/bram_1rw.bo inter/tlb.bo inter/mshr.bo
	rm -f inter/mkfill_buffer_instance.ba inter/mkmshr_instance.ba
